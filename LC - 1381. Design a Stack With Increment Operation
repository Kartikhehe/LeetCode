#include<bits/stdc++.h>

class CustomStack {
private:
vector<int> st;
int capacity;

public:

    CustomStack(int maxSize) {
        st = {};
        capacity = maxSize;
    }
    
    void push(int x) {
        if(st.size()>=capacity)return; 
        st.push_back(x);
        return;
    }
    
    int pop() {
        if(st.empty())return -1;
        int temp = st[st.size()-1];
        st.pop_back();
        return temp;
    }
    
    void increment(int k, int val) {
        for(int i = 0; i < min((int)st.size(), k); i++) {
            st[i] += val;
        }return;
    }
};

